@{
    ViewData["Title"] = "Access Request Hub";
    Layout = null;
}
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <link rel="stylesheet" href="/css/site.css" />
</head>

<body>
    <main>
        <header>
            <div>
                <h1>Access Request Hub</h1><span>Local MVP — backend authorization is enforced for every action.</span>
            </div>
            <label>Act as
                <select id="user">
                    <option value="alice@example.local">Alice — Requester</option>
                    <option value="bob@example.local">Bob — Manager</option>
                    <option value="carol@example.local">Carol — CRM Owner</option>
                    <option value="dana@example.local">Dana — Finance Owner</option>
                    <option value="erin@example.local">Erin — Auditor</option>
                </select>
            </label>
        </header>
        <div id="message" class="hidden" role="alert"></div>
        <section id="create-section">
            <h2>Create access request</h2>
            <form id="create-form">
                <label>Application <select id="application" required></select></label>
                <label>Environment <select id="environment">
                    <option value="0">Non-production</option>
                    <option value="1">Production</option>
                </select></label>
                <label>Access level <select id="access-level">
                    <option value="0">Read</option>
                    <option value="1">Admin</option>
                </select></label>
                <label style="grid-column: 1 / -1">Business justification <textarea id="justification" required
                                                                                        maxlength="2000"></textarea></label>
                    <button type="submit">Submit request</button>
                </form>
            </section>
            <section>
                <h2 id="list-heading">My requests</h2>
                <button id="refresh" class="secondary">Refresh</button>
                <div id="empty" class="hidden">No requests to display.</div>
                <table>
                    <thead>
                        <tr>
                            <th>Application</th>
                            <th>Requester</th>
                            <th>Environment</th>
                            <th>Access</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="request-list"></tbody>
                </table>
            </section>
            <section id="detail-section" class="hidden">
                <h2>Request detail</h2>
                <div id="detail"></div>
            </section>
        </main>
        <script>
                const $ = id => document.getElementById(id);
                const api = (path, options = {}) => fetch(`/api${path}`, { ...options, headers: { 'Content-Type': 'application/json', 'x-user-email': $('user').value, ...(options.headers || {}) } });
                const text = value => String(value ?? '').replace(/[&<>'"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[c]);
                const role = () => $('user').value.split('@@')[0];
                function show(message, error = false) { const box = $('message'); box.textContent = message; box.className = error ? 'error' : ''; }
                async function body(response) { const json = await response.json().catch(() => ({})); if (!response.ok) throw new Error(json.error || `Request failed (${response.status}).`); return json; }
                async function loadApps() { const apps = await body(await api('/applications')); $('application').innerHTML = apps.map(a => `<option value="${a.id}">${text(a.name)}</option>`).join(''); }
                async function loadRequests() {
                    const requests = await body(await api('/requests'));
                    $('list-heading').textContent = role() === 'alice' ? 'My requests' : role() === 'erin' ? 'All requests' : 'Approval inbox';
                    $('create-section').classList.toggle('hidden', role() !== 'alice');
                    $('empty').classList.toggle('hidden', requests.length !== 0);
                    $('request-list').innerHTML = requests.map(r => `<tr><td>${text(r.applicationName)}</td><td>${text(r.requesterEmail)}</td><td>${text(r.environment)}</td><td>${text(r.accessLevel)}</td><td><span class="status ${r.status}">${text(r.status)}</span></td><td><button class="secondary" data-id="${r.id}">View</button></td></tr>`).join('');
                }
                async function loadDetail(id) {
                    const request = await body(await api(`/requests/${id}`));
                    const actionable = ['PendingManager', 'PendingSystemOwner'].includes(request.status) && !['alice', 'erin'].includes(role());
                    $('detail-section').classList.remove('hidden');
                    $('detail').innerHTML = `<dl><dt>Requester</dt><dd>${text(request.requesterEmail)}</dd><dt>Request</dt><dd>${text(request.applicationName)} · ${text(request.environment)} · ${text(request.accessLevel)}</dd><dt>Justification</dt><dd>${text(request.justification)}</dd><dt>Status</dt><dd><span class="status ${request.status}">${text(request.status)}</span></dd></dl>${actionable ? `<div class="grid"><button id="approve">Approve</button><label>Reject reason <input id="reason" maxlength="2000" placeholder="Required to reject" /></label><button id="reject" class="reject">Reject</button></div>` : ''}<h3>Audit timeline</h3><ul>${request.auditTrail.map(e => `<li><strong>${text(e.action)}</strong> — ${text(e.actorEmail)} (${new Date(e.timestamp).toLocaleString()})${e.reason ? `: ${text(e.reason)}` : ''}</li>`).join('')}</ul>`;
                    $('approve')?.addEventListener('click', () => transition(id, 'approve', { version: request.version }));
                    $('reject')?.addEventListener('click', () => transition(id, 'reject', { version: request.version, reason: $('reason').value }));
                }
                async function transition(id, action, payload) { try { await body(await api(`/requests/${id}/${action}`, { method: 'POST', body: JSON.stringify(payload) })); show(`Request ${action}d.`); await loadRequests(); await loadDetail(id); } catch (error) { show(error.message, true); } }
                $('create-form').addEventListener('submit', async event => { event.preventDefault(); try { const result = await body(await api('/requests', { method: 'POST', body: JSON.stringify({ clientRequestId: crypto.randomUUID(), applicationId: $('application').value, environment: Number($('environment').value), accessLevel: Number($('access-level').value), justification: $('justification').value }) })); $('create-form').reset(); show(`Request ${result.id} submitted.`); await loadRequests(); await loadDetail(result.id); } catch (error) { show(error.message, true); } });
                $('request-list').addEventListener('click', event => { if (event.target.dataset.id) loadDetail(event.target.dataset.id).catch(error => show(error.message, true)); });
                $('user').addEventListener('change', () => { $('detail-section').classList.add('hidden'); loadRequests().catch(error => show(error.message, true)); });
                $('refresh').addEventListener('click', () => loadRequests().catch(error => show(error.message, true)));
                (async () => { try { await loadApps(); await loadRequests(); } catch (error) { show(error.message, true); } })();
        </script>
    </body>

</html>
